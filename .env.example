# Neon Postgres
# Pooled connection for the app (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Direct connection for Drizzle migrations. `neon deploy` pulls both.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth.js
# Generate AUTH_SECRET with: openssl rand -base64 32
# Set AUTH_URL to the production origin when deploying.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# School access
# Sign-in is limited to verified Google accounts at this domain.
SCHOOL_DOMAIN="school.edu"
# Comma-separated. These accounts are always admins, with or without a grant.
ADMIN_EMAILS="librarian@school.edu"

# Optional IANA timezone for door times and greetings. Defaults to Europe/London.
SCHOOL_TIME_ZONE="Africa/Nairobi"

# Vercel Blob, used for device and serial photos
# Create a public Blob store. Uploads are scoped under devices/<user id>/.
BLOB_READ_WRITE_TOKEN=""
# Optional. The store id can be set explicitly if the token does not expose it.
BLOB_STORE_ID=""

# Door codes
# TOKEN_SECRET signs the short-lived QR tokens. Generate one with:
#   openssl rand -base64 32
TOKEN_SECRET=""
# CRON_SECRET protects /api/cron/auto-close. Vercel Cron sends it as a bearer
# token. Generate one with: openssl rand -base64 32
CRON_SECRET=""
# The public origin used inside the QR code. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Show a "Simulate scan" link on the door screens in local demos.
NEXT_PUBLIC_DEMO_MODE="false"
